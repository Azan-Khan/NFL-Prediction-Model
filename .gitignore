# ============================================
# Data Policy (Strict - Course Requirement)
# ============================================

# Raw data is NEVER committed (license/privacy compliance)
data/raw/*
!data/raw/.gitkeep

# Processed data is generated by code; regenerated on run
data/processed/*
!data/processed/.gitkeep

# Generated outputs (figures, model artifacts) are regeneratable
outputs/*
!outputs/.gitkeep

# ============================================
# Python & Environment
# ============================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# ============================================
# Jupyter & IDE
# ============================================

# Jupyter checkpoints
.ipynb_checkpoints/

# IDE settings
.vscode/
.idea/
*.swp
*.swo

# ============================================
# OS & Editor Junk
# ============================================

.DS_Store
Thumbs.db
*.log
*.tmp

# ============================================
# Secrets & Credentials
# ============================================

.env
*.key
*.pem
*.crt